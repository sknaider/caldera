# Caldera Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ==============================================================================
# SECURITY CRITICAL - Generate strong random values for production
# ==============================================================================

# API Keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
CALDERA_API_KEY_BLUE=generate-strong-random-key-here
CALDERA_API_KEY_RED=generate-strong-random-key-here

# Encryption (CRITICAL - generate unique values)
CALDERA_CRYPT_SALT=generate-64-char-hex-string-here
CALDERA_ENCRYPTION_KEY=generate-64-char-hex-string-here

# User Passwords (use strong passwords in production)
CALDERA_BLUE_PASSWORD=change-me-strong-password
CALDERA_RED_ADMIN_PASSWORD=change-me-strong-password
CALDERA_RED_PASSWORD=change-me-strong-password

# ==============================================================================
# OPTIONAL - External Service Integrations
# ==============================================================================

# GitHub Gist (for data exfiltration testing)
# CALDERA_GIST_API_KEY=your-github-gist-api-key

# Slack Integration
# CALDERA_SLACK_API_KEY=xoxb-your-slack-token
# CALDERA_SLACK_BOT_ID=your-bot-id
# CALDERA_SLACK_CHANNEL_ID=your-channel-id

# SSH Tunnel Configuration
# CALDERA_SSH_KEY_FILE=/path/to/ssh/key/file
# CALDERA_SSH_KEY_PASSPHRASE=your-key-passphrase
# CALDERA_SSH_USERNAME=sandcat
# CALDERA_SSH_PASSWORD=strong-ssh-password

# FTP Configuration
# CALDERA_FTP_USER=caldera_user
# CALDERA_FTP_PASSWORD=strong-ftp-password

# ==============================================================================
# ENVIRONMENT SETTINGS
# ==============================================================================

# Set to 'true' only in development environments
# This disables security checks for default credentials
CALDERA_DEV_MODE=false

# Application mode: development, staging, production
CALDERA_ENVIRONMENT=production
